# CureBharat Frontend — Environment Variables Template
# Copy this to .env.local and fill in the real values

# The URL of your backend API
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# The name of your application
NEXT_PUBLIC_APP_NAME=CureBharat MLM

# JWT secret for Edge Middleware (must match backend JWT_SECRET)
JWT_SECRET=your-64-character-secret-here
